{
  "name": "dsh-healthkit",
  "version": "0.8.6",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyunlai/dsh-healthkit.git"
  },
  "description": "DSH 体检：给 DeepSeek Harness 做体检——只读评分、可还原清理、分数趋势",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "audit",
    "health-check",
    "cli"
  ],
  "homepage": "https://github.com/zuoyunlai/dsh-healthkit#readme",
  "bugs": {
    "url": "https://github.com/zuoyunlai/dsh-healthkit/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "./index.js",
  "icon": "./logo.svg",
  "exports": {
    ".": "./index.js",
    "./icon": "./logo.svg",
    "./logo.svg": "./logo.svg",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./engine": "./src/engine.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-healthkit": "bin/audit.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "logo.svg",
    "cordis.patch.yml",
    "src/*.mjs",
    "bin/audit.mjs",
    "config/*.json",
    "test/*.mjs",
    "fixtures/*.json",
    "docs/ISSUES.md",
    "docs/NOTES-host-contract.md"
  ],
  "scripts": {
    "audit": "node ./bin/audit.mjs",
    "test": "node ./test/rules-on-fixture.mjs && node ./test/invariants.mjs && node ./test/reportpath.mjs && node ./test/version-guard.mjs && node ./test/migrate-guard.mjs && node ./test/tools-shape.mjs && node ./test/panel.mjs && node ./test/apply-inject.mjs && node ./test/capability-map.mjs && node ./test/false-positive-zone.mjs && node ./test/degradation.mjs && node ./test/snapshot.mjs && node ./test/portability.mjs && node ./test/r22-local-deps.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "capabilities": [
      "tools:register",
      "fs:read"
    ],
    "commitments": {
      "no-session-upload": true,
      "no-third-party-proxy": true,
      "no-credential-enumeration": true,
      "no-webhook-auto-session": true
    },
    "compatibility": {
      "dsh": ">=0.2.1-alpha.2 <0.3.0",
      "profiles": [
        "desktop",
        "web"
      ]
    },
    "disclosure": {
      "endpoints": [],
      "retention": "审计产物写会话工作区（AUDIT-<日期>.md）；证据快照、退役记录在 $DSH_HOME/dsh-healthkit/；不联网、不上传会话内容"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.1",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
