{
  "name": "dsh-auditkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 整机体检器：只读审计、评分、能力缺口与可回滚修复（host-agnostic engine + CLI）",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./engine": "./src/engine.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-auditkit": "./bin/audit.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src/*.mjs",
    "bin/audit.mjs",
    "config/*.json",
    "test/*.mjs",
    "fixtures/*.json",
    "docs/*.md"
  ],
  "scripts": {
    "audit": "node ./bin/audit.mjs",
    "test": "node ./test/rules-on-fixture.mjs && node ./test/invariants.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "capabilities": [
      "tools:register",
      "fs:read"
    ],
    "commitments": {
      "no-session-upload": true,
      "no-third-party-proxy": true,
      "no-credential-enumeration": true,
      "no-webhook-auto-session": true
    },
    "compatibility": {
      "dsh": ">=0.2.1-alpha.2 <0.3.0",
      "profiles": [
        "desktop",
        "web"
      ]
    },
    "disclosure": {
      "endpoints": [],
      "retention": "审计产物写会话工作区（AUDIT-<日期>.md）；证据快照、退役记录在 $DSH_HOME/dsh-auditkit/；不联网、不上传会话内容"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
